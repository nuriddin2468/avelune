{
  "name": "test-check",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/test-check",
  "tags": ["type:tool"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "inputs": [
        "default",
        "{workspaceRoot}/packages/ui/project.json",
        "{workspaceRoot}/packages/ui/tsconfig*.json",
        "{workspaceRoot}/packages/ui/scripts/size-limit.mts",
        "{workspaceRoot}/packages/ui/scripts/api-report.mjs",
        "{workspaceRoot}/tools/visual/playwright.config.ts",
        "{workspaceRoot}/tools/invariants/playwright.config.ts",
        "{workspaceRoot}/tools/visual/src/**/*",
        {
          "externalDependencies": [
            "vitest",
            "@vitest/coverage-v8",
            "@vitest/browser-playwright",
            "@angular/build",
            "size-limit",
            "@size-limit/file",
            "@size-limit/esbuild",
            "@playwright/test",
            "@microsoft/api-extractor"
          ]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --test \"src/*.spec.ts\""
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["tokens"],
          "target": "build"
        }
      ],
      "inputs": [
        "default",
        "{workspaceRoot}/apps/storybook/.storybook/**/*",
        "{workspaceRoot}/apps/storybook/tsconfig.json",
        "{workspaceRoot}/packages/ui/styles/**/*",
        "{workspaceRoot}/tools/visual/**/*",
        "!{workspaceRoot}/tools/visual/baselines/**",
        "{workspaceRoot}/tools/invariants/**/*",
        {
          "dependentTasksOutputFiles": "**/*"
        },
        {
          "externalDependencies": ["@playwright/test", "@axe-core/playwright", "storybook", "@storybook/angular-vite"]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --test --test-concurrency=1 \"src/e2e/*.spec.ts\""
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.json"
      }
    }
  }
}
