{
  "name": "test-check",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/test-check",
  "tags": ["type:tool"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/packages/ui/project.json",
        "{workspaceRoot}/packages/ui/tsconfig*.json",
        "{workspaceRoot}/packages/ui/scripts/size-limit.mts",
        {
          "externalDependencies": [
            "vitest",
            "@vitest/coverage-v8",
            "@vitest/browser-playwright",
            "@angular/build",
            "size-limit",
            "@size-limit/file",
            "@size-limit/esbuild"
          ]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --test \"src/**/*.spec.ts\""
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.json"
      }
    }
  }
}
