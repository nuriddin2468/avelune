{
  "name": "repo-check",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/repo-check",
  "tags": ["type:tool"],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "{workspaceRoot}/.browserslistrc",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/**/project.json",
        "{workspaceRoot}/**/package.json",
        { "externalDependencies": ["@mdn/browser-compat-data", "browserslist", "@angular/build", "nx"] }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node src/cli.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/.browserslistrc",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/commitlint.config.mjs",
        "{workspaceRoot}/.prettierrc.json",
        "{workspaceRoot}/.prettierignore",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/**/project.json",
        {
          "externalDependencies": [
            "@mdn/browser-compat-data",
            "browserslist",
            "@angular/build",
            "nx",
            "@commitlint/cli",
            "@commitlint/config-conventional",
            "@commitlint/config-nx-scopes",
            "prettier"
          ]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --test \"src/**/*.spec.ts\""
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.json"
      }
    }
  }
}
