# Dependencies
node_modules/

# Build output
dist/
# ...except the built CSS inside tokens-check fixtures, which is test input
!/tools/tokens-check/fixtures/*/dist/
out-tsc/
tmp/
storybook-static/

# Caches
.nx/cache/
.nx/workspace-data/
.angular/
.eslintcache
.stylelintcache

# Test output and browser-automation artefacts
coverage/
test-results/
playwright-report/
**/__screenshots__/*-actual.png
**/__screenshots__/*-diff.png
# Vitest browser mode's screenshots of failed tests and stories, in a folder named after the test file (debugging
# output, never baselines)
**/__screenshots__/*.ts/
.vitest-attachments/

# Environment and OS
.env
.env.*
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Agent tooling: per-user settings stay local
.claude/settings.local.json
.playwright-mcp/
