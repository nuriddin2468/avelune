{
  "name": "storybook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/storybook",
  "tags": ["type:app"],
  "implicitDependencies": ["tokens"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["tokens", "icons"],
          "target": "build"
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "storybook dev --host 127.0.0.1 --port 6006 --config-dir .storybook --no-open --ci"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["tokens", "icons"],
          "target": "build"
        }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/storybook"],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "storybook build --config-dir .storybook --output-dir ../../dist/apps/storybook --quiet"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/packages/ui/**/*.stories.ts",
        {
          "externalDependencies": [
            "storybook",
            "@storybook/angular-vite",
            "@storybook/addon-docs",
            "@storybook/addon-a11y"
          ]
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["tokens", "icons"],
          "target": "build"
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "ngc -p tsconfig.json --noEmit"
      }
    },
    "stylelint": {},
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["tokens", "icons"],
          "target": "build"
        }
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/packages/ui/**/*.stories.ts",
        {
          "externalDependencies": [
            "storybook",
            "@storybook/angular-vite",
            "@storybook/addon-vitest",
            "@storybook/addon-a11y",
            "vitest",
            "@vitest/browser-playwright"
          ]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run --config vitest.config.ts"
      }
    }
  }
}
