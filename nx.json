{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "analytics": false,
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/.browserslistrc",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.stories.ts",
      "!{projectRoot}/**/fixtures/**",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/eslint.config.mjs"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "typecheck": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/lint-rules/**/*"
      ],
      "options": {
        "args": ["--max-warnings=0"]
      },
      "cache": true
    },
    "stylelint": {
      "dependsOn": [
        {
          "projects": ["tokens"],
          "target": "build"
        }
      ],
      "inputs": [
        "default",
        "{workspaceRoot}/stylelint.config.mjs",
        "{workspaceRoot}/tools/lint-rules/src/stylelint/**/*",
        {
          "dependentTasksOutputFiles": "**/*.css"
        },
        {
          "externalDependencies": [
            "stylelint",
            "stylelint-config-standard",
            "stylelint-declaration-strict-value",
            "stylelint-value-no-unknown-custom-properties",
            "stylelint-plugin-logical-css"
          ]
        }
      ],
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "stylelint \"**/*.css\" --allow-empty-input --max-warnings=0"
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ]
}
