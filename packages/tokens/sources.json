{
  "$comment": "Tier of every DTCG source file and the override files (ADR 0016). Read by scripts/build.ts and tools/tokens-check.",
  "tiers": {
    "primitive": ["src/primitives.color.tokens.json", "src/primitives.tokens.json"],
    "semantic": [
      "src/semantic.tokens.json",
      "src/semantic.light.tokens.json",
      "src/semantic.dark.tokens.json",
      "src/motion.tokens.json",
      "src/motion.reduced.tokens.json"
    ],
    "component": ["src/component.tokens.json", "src/density.compact.tokens.json"]
  },
  "overrides": {
    "src/semantic.dark.tokens.json": { "base": "src/semantic.light.tokens.json", "names": "same" },
    "src/density.compact.tokens.json": { "base": "src/component.tokens.json", "names": "subset" },
    "src/motion.reduced.tokens.json": { "base": "src/motion.tokens.json", "names": "subset" }
  }
}
