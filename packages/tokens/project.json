{
  "name": "tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/tokens",
  "tags": ["layer:tokens"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "colors"],
      "inputs": [
        "production",
        {
          "externalDependencies": ["style-dictionary", "typescript"]
        }
      ],
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["node scripts/build.ts", "tsc -p tsconfig.dist.json"],
        "parallel": false
      }
    },
    "colors": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/scripts/**/*",
        "!{projectRoot}/scripts/**/*.spec.ts",
        "{projectRoot}/src/primitives.color.tokens.json",
        "{workspaceRoot}/.prettierrc.json",
        {
          "externalDependencies": ["colorjs.io", "prettier"]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/generate-colors.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        {
          "externalDependencies": ["colorjs.io", "style-dictionary"]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --test \"scripts/**/*.spec.ts\""
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.json"
      }
    }
  }
}
