      "minimum": 3,
      "foreground": ["color.border.focus"],
      "background": [
        "color.accent.bg-subtle",
        "color.info.bg-subtle",
        "color.success.bg-subtle",
        "color.warning.bg-subtle",
        "color.danger.bg-subtle"
