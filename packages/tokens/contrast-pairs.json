    {
      "reason": "Role-coloured boundaries: invalid inputs, selected cards (WCAG 1.4.11)",
      "minimum": 3,
      "foreground": [
        "color.accent.border",
        "color.info.border",
        "color.success.border",
        "color.warning.border",
        "color.danger.border"
