{
  "name": "icons",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/icons",
  "tags": ["layer:foundations"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/scripts/**/*",
        "!{projectRoot}/scripts/**/*.spec.ts",
        "{projectRoot}/src/index.ts",
        "{projectRoot}/src/lucide.ts",
        "{projectRoot}/src/lucide-all.ts",
        "{projectRoot}/LICENSE-lucide.txt",
        "{workspaceRoot}/.prettierrc.json",
        {
          "externalDependencies": ["lucide-static", "prettier"]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/generate.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "inputs": [
        "production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.dist.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        {
          "externalDependencies": ["lucide-static"]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --test \"scripts/**/*.spec.ts\""
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.json"
      }
    },
    "size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/dist/**/*",
        "{projectRoot}/scripts/size-limit.mts",
        {
          "externalDependencies": ["size-limit", "@size-limit/file", "@size-limit/esbuild"]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "size-limit --config scripts/size-limit.mts"
      }
    }
  }
}
