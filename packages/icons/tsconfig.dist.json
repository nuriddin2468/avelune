/* Compiles the generated src/index.ts and src/lucide.ts, and src/lucide-all.ts, into the published dist/. */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "importHelpers": false,
    "sourceMap": false,
    "types": []
  },
  "files": ["src/index.ts", "src/lucide.ts", "src/lucide-all.ts"]
}
