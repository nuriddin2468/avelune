{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/ui",
  "tags": ["layer:patterns"],
  "targets": {
    "build-lib": {
      "executor": "@angular/build:ng-packagr",
      "outputs": ["{workspaceRoot}/dist/packages/ui"],
      "options": {
        "project": "packages/ui/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/ui/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/ui/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-lib", "^build"],
      "outputs": ["{workspaceRoot}/dist/packages/ui/schematics"],
      "options": {
        "cwd": "packages/ui",
        "commands": ["tsc -p tsconfig.schematics.json", "node scripts/copy-schematics-assets.mjs"],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "ngc -p tsconfig.lib.json --noEmit",
          "ngc -p tsconfig.spec.json --noEmit",
          "tsc -p tsconfig.schematics.json --noEmit",
          "tsc -p scripts/tsconfig.json",
          "tsc -p schematics/tests/tsconfig.json"
        ]
      }
    },
    "api-report": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "{workspaceRoot}/dist/packages/ui/types/**/*",
        "{projectRoot}/api/**/*",
        "{projectRoot}/scripts/api-report.mjs",
        {
          "externalDependencies": ["@microsoft/api-extractor"]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/api-report.mjs"
      }
    },
    "size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-lib"],
      "inputs": [
        "{workspaceRoot}/dist/packages/ui/fesm2022/**/*",
        "{projectRoot}/*/entry.json",
        "{projectRoot}/package.json",
        "{projectRoot}/scripts/size-limit.mts",
        {
          "externalDependencies": ["size-limit", "@size-limit/file", "@size-limit/esbuild"]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "size-limit --config scripts/size-limit.mts"
      }
    },
    "stylelint": {},
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "ui:build-lib:development",
        "tsConfig": "packages/ui/tsconfig.spec.json",
        "runner": "vitest",
        "browsers": ["chromium"],
        "headless": true,
        "watch": false,
        "coverage": true,
        "coverageInclude": ["packages/ui/**/*.ts"],
        "coverageExclude": [
          "packages/ui/**/*.spec.ts",
          "packages/ui/**/*.stories.ts",
          "packages/ui/**/index.ts",
          "packages/ui/schematics/**",
          "packages/ui/scripts/**",
          "packages/ui/**/fixtures/**"
        ],
        "coverageReporters": [
          "text-summary",
          [
            "text",
            {
              "skipFull": true
            }
          ]
        ],
        "coverageThresholds": {
          "perFile": true,
          "statements": 90,
          "branches": 90,
          "functions": 90,
          "lines": 90
        }
      },
      "configurations": {
        "coverage-gap": {
          "tsConfig": "tools/test-check/fixtures/coverage-gap/tsconfig.spec.json",
          "include": ["../../tools/test-check/fixtures/coverage-gap/*.spec.ts"],
          "coverageInclude": ["tools/test-check/fixtures/coverage-gap/*.ts"],
          "coverageExclude": ["tools/test-check/fixtures/coverage-gap/*.spec.ts"]
        }
      }
    },
    "test-schematics": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "{workspaceRoot}/dist/packages/ui/schematics/**/*",
        "{workspaceRoot}/dist/packages/ui/package.json",
        "{projectRoot}/schematics/tests/**/*",
        "{workspaceRoot}/packages/*/package.json",
        {
          "externalDependencies": ["@angular-devkit/schematics"]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --test \"schematics/tests/*.spec.mts\""
      }
    }
  }
}
