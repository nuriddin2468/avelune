/* Editor and type-aware lint config for the library sources, specs and stories (the schematics and the build scripts
   have their own in schematics/ and scripts/). Builds use tsconfig.lib.json and tsconfig.lib.prod.json. */
{
  "extends": "./tsconfig.lib.json",
  "include": ["**/*.ts"],
  "exclude": ["schematics/**", "scripts/**", "**/fixtures/**"]
}
