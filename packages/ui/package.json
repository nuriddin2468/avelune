{
  "name": "@avelune/ui",
  "version": "0.0.0",
  "description": "Avelune Angular UI kit. Import components from their entry points, for example @avelune/ui/button.",
  "license": "MIT AND OFL-1.1",
  "peerDependencies": {
    "@angular/aria": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/router": "^22.2.0"
  },
  "exports": {
    "./styles.css": "./styles/styles.css",
    "./fonts/*": "./styles/fonts/*"
  },
  "dependencies": {
    "@avelune/icons": "workspace:*",
    "@avelune/tokens": "workspace:*",
    "@maskito/core": "catalog:",
    "@maskito/kit": "catalog:",
    "tslib": "^2.8.1"
  },
  "sideEffects": [
    "*.css"
  ],
  "schematics": "./schematics/collection.json",
  "ng-update": {
    "migrations": "./schematics/migrations.json",
    "packageGroup": [
      "@avelune/tokens",
      "@avelune/ui",
      "@avelune/icons",
      "@avelune/eslint-config",
      "@avelune/stylelint-config"
    ]
  },
  "ng-add": {
    "save": "dependencies"
  }
}
