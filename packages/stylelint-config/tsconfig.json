/* Type-checks the tests, which import the built dist/index.js as an application does (ADR 0015, 0104). The source is
   tools/lint-rules/src/consumers, type-checked with that project. */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts"]
}
